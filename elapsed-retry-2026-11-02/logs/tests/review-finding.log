# Review finding: the budget ends while a slow proxy attempt is in flight (300 ms per attempt, 1 s budget).
# The test fails when the caller gets the attempt's own deadline error instead of the proxy's Unavailable.

$ go test -race -count=10 -overlay=<pre-fix store.go + slow-proxy test> ./adk/pkg/taskstore -run TestScratchSlowProxyBudget -v
  10 final=rpc error: code = DeadlineExceeded desc = context deadline exceeded

$ go test -race -count=10 -overlay=<slow-proxy test> ./adk/pkg/taskstore -run TestScratchSlowProxyBudget -v    # 8f893624
  10 final=rpc error: code = Unavailable desc = upstream call failed: Connect: Connection refused (os error 111)

